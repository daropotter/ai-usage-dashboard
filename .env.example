# Backend server
PORT=8080

# OpenAI organization billing/cost API. Admin key is recommended/typically required.
OPENAI_ADMIN_API_KEY=
# Optional fallback if your key has sufficient admin permissions:
OPENAI_API_KEY=
# Optional dashboard-only cap; does not change the provider account.
OPENAI_MONTHLY_LIMIT_USD=

# Anthropic Usage & Cost Admin API (organization admin key).
ANTHROPIC_ADMIN_API_KEY=
# Optional dashboard-only cap.
ANTHROPIC_MONTHLY_LIMIT_USD=

# OpenCode Go quota API.
OPENCODE_GO_API_KEY=

# Ollama Cloud API key; /api/usage is currently an undocumented/best-effort surface.
OLLAMA_API_KEY=

# Optional endpoint overrides (useful for testing/proxies, no model calls are made):
# OPENAI_COSTS_URL=https://api.openai.com/v1/organization/costs
# ANTHROPIC_COSTS_URL=https://api.anthropic.com/v1/organizations/cost_report
# OPENCODE_GO_USAGE_URL=https://opencode.ai/zen/go/v1/usage
# OLLAMA_USAGE_URL=https://ollama.com/api/usage
