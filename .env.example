# Backend server
PORT=8080

# OpenAI — organization Costs API (key with admin permissions; falls back to OPENAI_API_KEY).
OPENAI_ADMIN_API_KEY=
OPENAI_API_KEY=
# Optional local budget limit (dashboard only, does not change the account).
OPENAI_MONTHLY_LIMIT_USD=

# OpenCode Go — quota API ("OpenCode Go A" tile).
OPENCODE_GO_API_KEY=
# OpenCode Go — second account ("OpenCode Go B" tile).
OPENCODE_GO_B_API_KEY=

# Ollama Cloud — /api/usage (Bearer OLLAMA_API_KEY).
OLLAMA_API_KEY=
# Optional usage window returned by the API: 24h | 7d | 30d (default 7d).
# OLLAMA_USAGE_RANGE=30d
# Optional local budget (USD) — adds a percentage bar to the usage cost.
# OLLAMA_MONTHLY_LIMIT_USD=300
# The older format returned the monthly limit without a reset date; provide a known date
# (RFC3339) and the backend will shift it into the future month by month.
# OLLAMA_RESET_ANCHOR=2026-01-01T00:00:00Z

# ChatGPT (subscription) — auth.json from Codex CLI (mount it and point to its path).
# CHATGPT_AUTH_FILE=/path/to/auth.json

# Claude / Anthropic (subscription) — .credentials.json from Claude Code.
# CLAUDE_AUTH_FILE=/path/to/.credentials.json

# Optional endpoint overrides (tests/proxy; no models are ever invoked):
# OPENAI_COSTS_URL=https://api.openai.com/v1/organization/costs
# OPENCODE_GO_USAGE_URL=https://opencode.ai/zen/go/v1/usage
# OPENCODE_GO_B_USAGE_URL=https://opencode.ai/zen/go/v1/usage
# OLLAMA_USAGE_URL=https://ollama.com/api/usage
# OLLAMA_BALANCE_URL=https://ollama.com/api/balance
# CHATGPT_USAGE_URL=https://chatgpt.com/backend-api/wham/usage
# CLAUDE_USAGE_URL=https://api.anthropic.com/api/oauth/usage
