# Backend server
PORT=8080

# OpenAI — organizacyjny Costs API (klucz z uprawnieniami admin; fallback OPENAI_API_KEY).
OPENAI_ADMIN_API_KEY=
OPENAI_API_KEY=
# Opcjonalny lokalny limit budżetu (tylko dashboard, nie zmienia konta).
OPENAI_MONTHLY_LIMIT_USD=

# OpenCode Go — quota API (kafelek "OpenCode Go A").
OPENCODE_GO_API_KEY=
# OpenCode Go — drugie konto (kafelek "OpenCode Go B").
OPENCODE_GO_B_API_KEY=

# Ollama Cloud — /api/usage (best-effort, nieudokumentowany endpoint).
OLLAMA_API_KEY=
# Ollama nie zwraca daty resetu limitu miesięcznego; podaj znaną datę (RFC3339),
# a backend będzie ją przesuwał co miesiąc w przyszłość.
# OLLAMA_RESET_ANCHOR=2026-01-01T00:00:00Z

# ChatGPT (subskrypcja) — plik auth.json z Codex CLI (zamontuj go i wskaż ścieżkę).
# CHATGPT_AUTH_FILE=/path/to/auth.json

# Claude / Anthropic (subskrypcja) — plik .credentials.json z Claude Code.
# CLAUDE_AUTH_FILE=/path/to/.credentials.json

# Opcjonalne nadpisania endpointów (testy/proxy; żadne modele nie są wywoływane):
# OPENAI_COSTS_URL=https://api.openai.com/v1/organization/costs
# OPENCODE_GO_USAGE_URL=https://opencode.ai/zen/go/v1/usage
# OPENCODE_GO_B_USAGE_URL=https://opencode.ai/zen/go/v1/usage
# OLLAMA_USAGE_URL=https://ollama.com/api/usage
# CHATGPT_USAGE_URL=https://chatgpt.com/backend-api/wham/usage
# CLAUDE_USAGE_URL=https://api.anthropic.com/api/oauth/usage
