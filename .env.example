# Backend server
PORT=8080

# ─── Tiles ────────────────────────────────────────────────────────────────────
# TILES lists the tile ids in display order. Each tile is configured with
# TILE_<ID>_* variables, where <ID> is the id upper-cased with "-" -> "_"
# (e.g. "ollama-balance" -> TILE_OLLAMA_BALANCE_*).
#
# Common keys:  TILE_<ID>_TYPE (required)  TILE_<ID>_NAME (optional title)
#
# Types and their keys:
#   openrouter     API_KEY, URL?, CREDITS_URL?
#   openai-costs    API_KEY (org admin key), MONTHLY_LIMIT_USD?, URL?
#   chatgpt         AUTH_FILE (Codex CLI auth.json), URL?, TOKEN_URL?
#   claude          AUTH_FILE (Claude Code .credentials.json), URL?, TOKEN_URL?
#   anthropic-api   API_KEY (org Admin API key), MONTHLY_LIMIT_USD?, USAGE_URL?, COST_URL?
#   ollama-usage    API_KEY, RANGE? (24h|7d|30d), MONTHLY_LIMIT_USD?, RESET_ANCHOR?, URL?
#   ollama-balance  API_KEY, RANGE? (24h|7d|30d), URL?, USAGE_URL?
#   opencode-go     API_KEY, URL?
#
# Several tiles may use the same type (e.g. two accounts of one provider):
# give each its own id and TILE_<ID>_* keys.
TILES=openrouter,openai,chatgpt,claude,anthropic-api,ollama,ollama-balance,opencode

# OpenRouter — account credits and usage/limits for this API key.
# Account credits may require a management key; ordinary keys still show usage.
TILE_OPENROUTER_TYPE=openrouter
TILE_OPENROUTER_API_KEY=

# OpenAI — organization Costs API (key with admin permissions).
TILE_OPENAI_TYPE=openai-costs
TILE_OPENAI_API_KEY=
# Optional local budget limit (dashboard only, does not change the account).
# TILE_OPENAI_MONTHLY_LIMIT_USD=100

# ChatGPT (subscription) — auth.json from Codex CLI (mount it and point to its path).
TILE_CHATGPT_TYPE=chatgpt
# TILE_CHATGPT_AUTH_FILE=/path/to/auth.json

# Claude (Pro/Max subscription) — .credentials.json from Claude Code.
TILE_CLAUDE_TYPE=claude
# TILE_CLAUDE_AUTH_FILE=/path/to/.credentials.json

# Anthropic API — token usage and cost this month from the Usage & Cost Admin API.
# Needs an organization Admin API key (sk-ant-admin...), not a regular API key.
TILE_ANTHROPIC_API_TYPE=anthropic-api
TILE_ANTHROPIC_API_API_KEY=
# Optional local budget limit (USD).
# TILE_ANTHROPIC_API_MONTHLY_LIMIT_USD=100

# Ollama Cloud — /api/usage.
TILE_OLLAMA_TYPE=ollama-usage
TILE_OLLAMA_API_KEY=
# Optional usage window returned by the API: 24h | 7d | 30d (default 7d).
# TILE_OLLAMA_RANGE=30d
# Optional local budget (USD) — adds a percentage bar to the usage cost.
# TILE_OLLAMA_MONTHLY_LIMIT_USD=100
# Older API format only: a known monthly reset date (RFC3339), shifted month by month.
# TILE_OLLAMA_RESET_ANCHOR=2026-01-01T00:00:00Z

# Ollama Cloud — /api/balance (monthly limit + reset date). Same key as above.
# Also calls /api/usage?group_by=model to list the most used models under the
# monthly limit (request count, plus cost or tokens when the API provides them).
TILE_OLLAMA_BALANCE_TYPE=ollama-balance
TILE_OLLAMA_BALANCE_API_KEY=
# Optional model-list window: 24h | 7d | 30d (default 7d).
# TILE_OLLAMA_BALANCE_RANGE=30d
# TILE_OLLAMA_BALANCE_USAGE_URL=https://ollama.com/api/usage

# OpenCode Go — quota API.
TILE_OPENCODE_TYPE=opencode-go
TILE_OPENCODE_API_KEY=

# Optional endpoint overrides per tile (tests/proxy; no models are ever invoked), e.g.:
# TILE_OPENROUTER_URL=https://openrouter.ai/api/v1/key
# TILE_OPENROUTER_CREDITS_URL=https://openrouter.ai/api/v1/credits
# TILE_OPENAI_URL=https://api.openai.com/v1/organization/costs
# TILE_CHATGPT_URL=https://chatgpt.com/backend-api/wham/usage
# TILE_CLAUDE_URL=https://api.anthropic.com/api/oauth/usage
# Reuse a successful usage result this long (the endpoint answers 429 when polled often).
# TILE_CLAUDE_CACHE_SECONDS=300
# TILE_ANTHROPIC_API_USAGE_URL=https://api.anthropic.com/v1/organizations/usage_report/messages
# TILE_ANTHROPIC_API_COST_URL=https://api.anthropic.com/v1/organizations/cost_report
# TILE_OLLAMA_URL=https://ollama.com/api/usage
# TILE_OLLAMA_BALANCE_URL=https://ollama.com/api/balance
# TILE_OPENCODE_URL=https://opencode.ai/zen/go/v1/usage
